{
  "name": "bunship",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun packages/cli/src/index.ts",
    "build": "bun --filter '*' build",
    "test": "bun test",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "check": "bun run lint && bun run format:check && bun run typecheck && bun run knip",
    "prepare": "husky"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "knip": "^6.27.0",
    "lint-staged": "^17.0.0",
    "oxfmt": "0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "^5.9.0"
  },
  "lint-staged": {
    "**/*.{ts,tsx,js,jsx,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ],
    "**/*.{json,jsonc,md,yml,yaml,css}": [
      "oxfmt"
    ]
  },
  "engines": {
    "bun": ">=1.3.0 <1.4.0"
  }
}
