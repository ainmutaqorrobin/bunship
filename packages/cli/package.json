{
  "name": "create-bunship",
  "version": "0.1.1",
  "description": "Scaffold and ship production-ready Bun monorepos using official framework scaffolders",
  "keywords": [
    "bun",
    "ci-cd",
    "cli",
    "create",
    "docker",
    "expo",
    "fastify",
    "hono",
    "monorepo",
    "nestjs",
    "nextjs",
    "nuxt",
    "scaffold",
    "vite"
  ],
  "homepage": "https://github.com/ainmutaqorrobin/bunship#readme",
  "bugs": {
    "url": "https://github.com/ainmutaqorrobin/bunship/issues"
  },
  "license": "MIT",
  "author": "ainmutaqorrobin <ainmutaqorrobin@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ainmutaqorrobin/bunship.git",
    "directory": "packages/cli"
  },
  "bin": {
    "create-bunship": "dist/index.mjs"
  },
  "files": [
    "dist",
    "templates"
  ],
  "type": "module",
  "scripts": {
    "dev": "bun src/index.ts",
    "build": "tsdown && node dist/index.mjs --selftest",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "prepublishOnly": "bun run build && bun test"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "commander": "^14.0.0",
    "tsdown": "^0.22.9",
    "unrun": "^0.3.1"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
